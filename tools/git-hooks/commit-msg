#!/usr/bin/env bash
# Commit-msg gate: rejects commit messages that embed high-signal
# internal planning / review IDs, or whose subject line exceeds the
# project's length rule. Patterns live in scripts/check-internal-ids.sh;
# the length bound lives in tools/git-hooks/check-subject-length.sh
# (each check's single source of truth).
#
# Git passes the path to the prepared commit-message file as $1.
#
# Install via: bash tools/git-hooks/install.sh

set -e

ROOT="$(git rev-parse --show-toplevel)"

# Warn (never fail) if this hook is a stale copy rather than install.sh's
# symlink. See tools/git-hooks/check-drift.sh. The source is guarded on
# the file's presence AND wrapped in `|| true`: a missing helper, an
# unreadable one, or one that's syntactically broken mid-edit must all
# leave the commit path alone under `set -e`. Gating the call on
# `declare -f` (not the source's own exit code) stops a partial source
# from leaving "check_hook_drift: command not found" as the next
# statement.
if [[ -f "$ROOT/tools/git-hooks/check-drift.sh" ]]; then
    source "$ROOT/tools/git-hooks/check-drift.sh" 2>/dev/null || true
    if declare -f check_hook_drift >/dev/null 2>&1; then
        check_hook_drift "commit-msg" "$0" "$ROOT/tools/git-hooks/commit-msg" || true
    fi
fi

# Both checks below are real gates: when their script is PRESENT, a
# finding blocks the commit (`set -e` propagates their non-zero exit).
# But `.git/hooks/commit-msg` is a symlink shared by every worktree of
# this repo, so ROOT here is the CHECKED-OUT tree, not the tree that
# owns the hook. A tree cut before a given check script existed (an
# older worktree, a bisect step, a pre-check branch) would otherwise hit
# a bare "No such file or directory" and block every commit under
# `set -e`, with no way to satisfy a rule the tree predates. Treat a
# missing checker as "this tree predates the rule": warn loudly and
# allow, rather than refuse. A checker that IS present still enforces
# fail-closed with no change in behavior.
run_gate() {
    local script="$1"
    shift
    if [[ ! -f "$script" ]]; then
        echo "commit-msg: WARNING: $script not found in this checkout -- this tree predates the check, so it is SKIPPED and the commit is ALLOWED without it" >&2
        return 0
    fi
    bash "$script" "$@"
}

run_gate "$ROOT/scripts/check-internal-ids.sh" --commit-msg "$1"
run_gate "$ROOT/tools/git-hooks/check-subject-length.sh" "$1"
