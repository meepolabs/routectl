#!/usr/bin/env bash
# Pre-commit gate matching .github/workflows/ci.yml job "fmt + clippy + check".
# Runs the checks CI runs, plus one local-only leg (public-api baseline
# drift) that CI does not run, so a push that lands clean here lands clean
# in CI too. Set ROUTECTL_SKIP_PRECOMMIT=1 to bypass when iterating fast.
#
# This file is the source of truth for the pre-commit hook. Install it
# (and commit-msg) into .git/hooks via:
#   bash tools/git-hooks/install.sh

set -e

if [[ "${ROUTECTL_SKIP_PRECOMMIT:-0}" == "1" ]]; then
    echo "pre-commit: ROUTECTL_SKIP_PRECOMMIT=1, skipping"
    exit 0
fi

# Move to repo root so cargo finds the workspace.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# gitleaks: REQUIRED, with a version FLOOR. A stale or unversioned local
# gitleaks silently lacks rules the CI gitleaks-action has (this bit us once:
# an old /usr/bin/gitleaks missed a `jwt` finding the action caught), so the
# hook fails closed unless a recognized gitleaks >= MIN_GITLEAKS is present.
# Keep MIN_GITLEAKS in lockstep with GITLEAKS_VERSION in
# .github/workflows/gitleaks.yml so local and CI scan with the same ruleset.
MIN_GITLEAKS="8.30.1"
echo "pre-commit: gitleaks (staged secret scan, require >= $MIN_GITLEAKS)"
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: ERROR gitleaks not installed; need >= $MIN_GITLEAKS" >&2
    exit 1
fi
GLV="$(gitleaks version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
if [[ -z "$GLV" ]]; then
    echo "pre-commit: ERROR could not read gitleaks version; need >= $MIN_GITLEAKS" >&2
    exit 1
fi
if [[ "$(printf '%s\n%s\n' "$MIN_GITLEAKS" "$GLV" | sort -V | head -1)" != "$MIN_GITLEAKS" ]]; then
    echo "pre-commit: ERROR gitleaks $GLV is older than required $MIN_GITLEAKS; update it" >&2
    exit 1
fi
gitleaks protect --staged --redact --no-banner

echo "pre-commit: internal-ID scan (staged added lines)"
bash scripts/check-internal-ids.sh --staged

echo "pre-commit: log-display scan (% tracing fields on wire-derived values)"
bash scripts/check-log-display.sh

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

# cargo fmt walks the module tree and so never opens an `include!`d fragment;
# without this leg the fmt gate above passes vacuously on all of them.
echo "pre-commit: rustfmt --check on include!d fragments"
bash scripts/fmt-fragments.sh

echo "pre-commit: cargo clippy --workspace --all-targets --all-features -- -D warnings"
cargo clippy --workspace --all-targets --all-features -- -D warnings

echo "pre-commit: cargo check (lean providers build)"
cargo check -p routectl-providers --no-default-features --features openai-compat,anthropic-api

# Public-API baseline drift (local-only leg; CI does not run this). The
# baseline went stale silently twice with nothing gating it locally, so
# this blocks wherever the tooling is present; it skips (does not fail)
# when the tooling is absent so a pinned nightly is never forced onto
# every contributor machine. Grep the pin out of the script rather than
# duplicating it here so the two never drift apart.
PUBLIC_API_NIGHTLY="$(grep -oE '^PUBLIC_API_NIGHTLY=.*' scripts/public-api.sh | cut -d= -f2)"
HAVE_CARGO_PUBLIC_API=0
command -v cargo-public-api >/dev/null 2>&1 && HAVE_CARGO_PUBLIC_API=1
HAVE_NIGHTLY=0
rustup toolchain list 2>/dev/null | grep -qF "$PUBLIC_API_NIGHTLY" && HAVE_NIGHTLY=1
if [[ "$HAVE_CARGO_PUBLIC_API" == "1" && "$HAVE_NIGHTLY" == "1" ]]; then
    echo "pre-commit: cargo-public-api baseline check (local-only leg; CI does not run this)"
    bash scripts/public-api.sh --check all
else
    echo "pre-commit: WARNING skipping public-api baseline check (local-only leg; CI does not run this)" >&2
    [[ "$HAVE_CARGO_PUBLIC_API" == "1" ]] || echo "pre-commit:   missing cargo-public-api -- install: cargo install cargo-public-api --version 0.52.0" >&2
    [[ "$HAVE_NIGHTLY" == "1" ]] || echo "pre-commit:   missing nightly toolchain $PUBLIC_API_NIGHTLY -- install: rustup toolchain install $PUBLIC_API_NIGHTLY --profile minimal" >&2
fi

echo "pre-commit: cargo doc (rustdoc lints denied)"
# Scoped to the PUBLIC doc surface (no --document-private-items): the
# private-items pass resolves links that break in the published docs, so
# denying against it would green-light exactly the breakage this gate
# exists to catch.
RUSTDOCFLAGS="-D rustdoc::all" cargo doc --workspace --all-features --no-deps

echo "pre-commit: cargo test --workspace --release"
# replay_egress and replay_ingress integration tests are temporarily
# skipped because the local captured/ corpus has bodies cut by
# systemd-journald LineMax (~48 KiB) leaving malformed JSON tails.
# Loader needs a tolerance pass + capture path needs to bypass journal.
# Re-enable by removing the --skip flags here once the loader skips
# malformed fixtures rather than panicking.
cargo test --workspace --release -- --skip egress_replay_all --skip ingress_replay_all

echo "pre-commit: all checks passed"
