# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local triage scratch -- findings + bug list from operator live debugging
# sessions. Not for public repo (contains environment-specific context
# like provider names + alias chains).
issues.md

# Captured live-traffic fixtures (raw, unsanitized bodies). Per-request
# directories under crates/routectl-cli/tests/fixtures/captured/ get
# auto-populated by scripts/capture_fixtures.sh from the TRACE log.
# Bodies contain user prompts AND model outputs -- never commit. A
# sanitized subset for CI ships separately under
# crates/routectl-cli/tests/fixtures/canon/ (not gitignored).
crates/routectl-cli/tests/fixtures/captured/
# meepoctl per-task worktrees + runtime state
.meepoctl/

# Local research scratch -- personal notes, config references, experiments.
scratch/
